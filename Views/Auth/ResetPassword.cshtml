@{
    ViewData["Title"] = "Reset Password";
    Layout = "_LayoutAuth";
}

<div class="auth-bg"></div>

<div class="auth-modal fade-in">

    <form method="post" class="auth-form" id="resetForm">

        <h2 class="auth-title">RESET PASSWORD</h2>

        <p class="auth-desc">Create your new password below.</p>

        @if (ViewBag.Error != null)
        {
            <div class="auth-error">@ViewBag.Error</div>
        }

        <!-- PASSWORD REQUIREMENT MESSAGE -->
        <div id="requirements" class="auth-error" style="display:none;">
            Password must be at least 8 characters, with uppercase, number, and symbol.
        </div>

        <!-- NEW PASSWORD -->
        <div class="input-group">
            <input name="newPassword" id="newPassword" class="input" placeholder="New Password" type="password" required />
            <span class="eye-icon" id="toggleNewPwd">&#128065;</span>
        </div>

        <!-- CONFIRM PASSWORD -->
        <div class="input-group">
            <input name="confirmPassword" id="confirmPassword" class="input" placeholder="Confirm Password" type="password" required />
            <span id="matchIcon" class="match-icon"></span>
            <span class="eye-icon" id="toggleConfirmPwd">&#128065;</span>
        </div>

        <button class="auth-btn" id="submitBtn" disabled>Change Password</button>

        <p class="auth-subtle">
            <a asp-action="Login">← Back to Sign In</a>
        </p>

    </form>

</div>

<!-- SUCCESS POPUP -->
@if (TempData["ResetSuccess"] != null)
{
    <div class="success-popup" id="successPopup">
        <div class="popup-box">
            <h3>Password Changed!</h3>
            <p>Your password has been successfully updated.</p>
            <button id="popupBtn">OK</button>
        </div>
    </div>
}

<style>
    .auth-bg {
        position: fixed;
        inset: 0;
        background: #eef2ff;
        z-index: -1;
    }

    .auth-modal {
        width: 420px;
        background: white;
        padding: 35px 35px 40px;
        border-radius: 18px;
        border: 1.8px solid rgba(200,210,255,0.55);
        box-shadow: 0 25px 55px rgba(0,0,0,0.18), 0 8px 20px rgba(0,0,0,0.08), inset 0 0 16px rgba(255,255,255,0.35);
        margin: 80px auto;
        animation: fadeIn 0.5s ease forwards;
    }

    .auth-title {
        text-align: center;
        color: #0f2b8f;
        font-size: 26px;
        font-weight: 700;
    }

    .auth-desc {
        text-align: center;
        color: #555;
        margin-bottom: 22px;
    }

    .auth-error {
        background: #fee2e2;
        color: #b91c1c;
        padding: 10px 14px;
        border-radius: 8px;
        text-align: center;
        margin-bottom: 12px;
        font-size: 14px;
    }

    .input-group {
        margin-bottom: 16px;
        position: relative;
    }

    .input {
        width: 100%;
        height: 46px;
        border: none;
        border-radius: 10px;
        background: #f3f4f6;
        padding: 0 16px;
        font-size: 15px;
    }

    .eye-icon {
        position: absolute;
        right: 12px;
        top: 12px;
        cursor: pointer;
        font-size: 17px;
        opacity: 0.7;
    }

    .match-icon {
        position: absolute;
        right: 40px;
        top: 12px;
        font-size: 20px;
        color: green;
    }

    .auth-btn {
        height: 48px;
        width: 100%;
        border-radius: 10px;
        border: none;
        background: linear-gradient(90deg,#4f7cff,#0f2b8f);
        color: #fff;
        font-weight: 700;
        font-size: 17px;
        cursor: pointer;
        margin-top: 10px;
        transition: 0.2s ease;
    }

        .auth-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .auth-btn:hover:not(:disabled) {
            transform: translateY(-1px);
        }

    .auth-subtle {
        margin-top: 16px;
        text-align: center;
        font-size: 14px;
    }

        .auth-subtle a {
            color: #2d47ff;
            font-weight: 600;
        }

    /* SUCCESS POPUP */
    .success-popup {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.5);
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .popup-box {
        background: white;
        padding: 25px 30px;
        border-radius: 16px;
        width: 320px;
        text-align: center;
        box-shadow: 0 20px 40px rgba(0,0,0,0.25);
        animation: pop .25s ease-out;
    }

    @@keyframes pop {
        from {
            transform: scale(0.8);
            opacity: 0;
        }

        to {
            transform: scale(1);
            opacity: 1;
        }
    }
</style>



@section Scripts {
    <script>

        // ---------------- SHOW/HIDE PASSWORD ----------------
        const newPwd = document.getElementById("newPassword");
        const confirmPwd = document.getElementById("confirmPassword");
        const requirements = document.getElementById("requirements");
        const submitBtn = document.getElementById("submitBtn");
        const matchIcon = document.getElementById("matchIcon");

        document.getElementById("toggleNewPwd").onclick = () => {
            newPwd.type = newPwd.type === "password" ? "text" : "password";
        };

        document.getElementById("toggleConfirmPwd").onclick = () => {
            confirmPwd.type = confirmPwd.type === "password" ? "text" : "password";
        };


        // ---------------- PASSWORD VALIDATION ----------------
        function validatePassword() {

            const pwd = newPwd.value;

            const valid =
                pwd.length >= 8 &&
                /[A-Z]/.test(pwd) &&
                /\d/.test(pwd) &&
                /[^A-Za-z0-9]/.test(pwd);

            if (!valid) {
                requirements.style.display = "block";
            } else {
                requirements.style.display = "none";
            }

            return valid;
        }

        // ---------------- LIVE VALIDATION + ENABLE SUBMIT ----------------
        function updateForm() {

            const validPassword = validatePassword();
            const passwordsMatch =
                confirmPwd.value === newPwd.value &&
                confirmPwd.value.length > 0;

            matchIcon.innerHTML = passwordsMatch ? "✔" : "";

            submitBtn.disabled = !(validPassword && passwordsMatch);
        }

        newPwd.addEventListener("input", updateForm);
        confirmPwd.addEventListener("input", updateForm);


        // ---------------- SUCCESS POPUP ----------------
        const popup = document.getElementById("successPopup");
        if (popup) {
            document.getElementById("popupBtn").onclick = () =>
                window.location.href = "/Auth/Login";
        }

    </script>
}
