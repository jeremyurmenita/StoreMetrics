@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_LayoutAuth";
}

<div class="fp-bg"></div>

<div class="fp-container">
    <div class="fp-box fade-in">

        <h2 class="fp-title">Forgot Password</h2>
        <p class="fp-text">Enter your username to receive an OTP.</p>

        @if (ViewBag.Error != null)
        {
            <div class="fp-error">@ViewBag.Error</div>
        }

        @if (TempData["Message"] != null)
        {
            <div class="fp-success">@TempData["Message"]</div>
        }

        <form method="post">
            <div class="fp-input-group">
                <input name="username" class="fp-input" placeholder="Enter your username" required />
            </div>

            <button class="fp-btn">Send OTP</button>

            <p class="fp-footer">
                Remember your password?
                <a asp-action="Login">Sign in</a>
            </p>
        </form>

    </div>
</div>

<style>
    /* Background */
    .fp-bg {
        position: fixed;
        inset: 0;
        background: #eef2ff;
        z-index: -1;
    }

    /* Center container */
    .fp-container {
        width: 100%;
        height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 20px;
    }

    /* Popup box */
    .fp-box {
        width: 420px;
        background: #ffffff;
        border-radius: 16px;
        padding: 35px 30px;
        box-shadow: 0 25px 55px rgba(0,0,0,0.18), 0 8px 20px rgba(0,0,0,0.08), inset 0 0 16px rgba(255,255,255,0.30);
        border: 1.5px solid rgba(200, 210, 255, 0.6);
        text-align: center;
        animation: fadeIn 0.5s ease forwards;
    }

    .fp-title {
        font-size: 26px;
        font-weight: 700;
        color: #0f2b8f;
        margin-bottom: 5px;
    }

    .fp-text {
        color: #555;
        font-size: 14px;
        margin-bottom: 20px;
    }

    .fp-input-group {
        margin-bottom: 16px;
    }

    .fp-input {
        width: 100%;
        height: 46px;
        background: #f3f4f6;
        border: none;
        border-radius: 10px;
        padding: 0 15px;
        font-size: 15px;
        outline: none;
    }

    .fp-btn {
        width: 100%;
        height: 48px;
        border: none;
        border-radius: 10px;
        background: linear-gradient(90deg, #4f7cff, #0f2b8f);
        color: white;
        font-size: 17px;
        font-weight: 700;
        cursor: pointer;
        transition: 0.2s ease;
        box-shadow: 0 8px 18px rgba(15,45,145,0.25);
    }

        .fp-btn:hover {
            transform: translateY(-1px);
        }

    .fp-error {
        background: #fee2e2;
        color: #b91c1c;
        padding: 10px;
        border-radius: 8px;
        margin-bottom: 12px;
        font-size: 14px;
    }

    .fp-success {
        background: #d1fae5;
        color: #065f46;
        padding: 10px;
        border-radius: 8px;
        margin-bottom: 12px;
        font-size: 14px;
    }

    .fp-footer {
        margin-top: 14px;
        font-size: 14px;
    }

        .fp-footer a {
            color: #2d47ff;
            font-weight: 600;
            text-decoration: none;
        }

    .fade-in {
        opacity: 0;
        transform: translateY(10px);
    }

    @@keyframes fadeIn {
        to

    {
        opacity: 1;
        transform: translateY(0);
    }

    }
</style>
