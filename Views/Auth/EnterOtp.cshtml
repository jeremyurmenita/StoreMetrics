@{
    ViewData["Title"] = "Enter OTP";
    Layout = "_LayoutAuth";
}

<div class="auth-bg"></div>

<div class="auth-modal fade-in">

    <!-- SUCCESS MESSAGE FROM FORGOTPASSWORD -->
    @if (TempData["Message"] != null)
    {
        <div class="auth-success">@TempData["Message"]</div>
    }

    <form method="post" class="auth-form">

        <h2 class="auth-title">ENTER OTP</h2>

        <p class="auth-desc">Please check your email for the 6-digit verification code.</p>

        @if (ViewBag.Error != null)
        {
            <div class="auth-error">@ViewBag.Error</div>
        }

        <div class="input-group">
            <input name="otp" class="input" placeholder="6-digit OTP" required />
        </div>

        <button class="auth-btn">Verify</button>

        <p class="auth-subtle">
            Didn’t receive the code?
            <a asp-action="ResendOtp">Resend OTP</a>

        </p>

        <p class="auth-subtle">
            <a asp-action="Login">← Back to Sign In</a>
        </p>

    </form>

</div>

<style>
    /* --- Background --- */
    .auth-bg {
        position: fixed;
        inset: 0;
        background: #eef2ff;
        z-index: -1;
    }

    /* --- Modal Container --- */
    .auth-modal {
        width: 420px;
        background: white;
        padding: 35px 35px 40px;
        border-radius: 18px;
        border: 1.8px solid rgba(200, 210, 255, 0.55);
        box-shadow: 0 25px 55px rgba(0,0,0,0.18), 0 8px 20px rgba(0,0,0,0.08), inset 0 0 16px rgba(255,255,255,0.35);
        margin: 80px auto;
        animation: fadeIn 0.5s ease forwards;
    }

    .fade-in {
        opacity: 0;
        transform: translateY(10px);
    }

    @@keyframes fadeIn {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* TITLE */
    .auth-title {
        text-align: center;
        color: #0f2b8f;
        font-size: 26px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    /* DESCRIPTION */
    .auth-desc {
        text-align: center;
        color: #555;
        font-size: 14px;
        margin-bottom: 18px;
    }

    /* SUCCESS BOX */
    .auth-success {
        background: #d1fae5;
        color: #065f46;
        padding: 10px 14px;
        border-radius: 8px;
        text-align: center;
        margin-bottom: 15px;
        font-size: 14px;
        border: 1px solid #aaeacf;
    }

    /* FORM */
    .auth-form {
        width: 100%;
        display: flex;
        flex-direction: column;
    }

    /* ERROR BOX */
    .auth-error {
        background: #fee2e2;
        color: #b91c1c;
        padding: 10px 14px;
        border-radius: 8px;
        text-align: center;
        font-size: 14px;
        margin-bottom: 12px;
    }

    /* INPUT */
    .input-group {
        margin-bottom: 14px;
        position: relative;
    }

    .input {
        width: 100%;
        height: 46px;
        border: none;
        outline: none;
        border-radius: 10px;
        background: #f3f4f6;
        padding: 0 16px;
        font-size: 15px;
    }

    /* BUTTON */
    .auth-btn {
        height: 48px;
        border-radius: 10px;
        border: none;
        background: linear-gradient(90deg, #4f7cff 0%, #0f2b8f 100%);
        color: #fff;
        font-weight: 700;
        font-size: 17px;
        cursor: pointer;
        box-shadow: 0 8px 18px rgba(15,45,145,.25);
        transition: 0.2s ease;
        margin-top: 6px;
    }

        .auth-btn:hover {
            transform: translateY(-1px);
        }

    /* LINKS */
    .auth-subtle {
        margin-top: 12px;
        text-align: center;
        font-size: 14px;
    }

        .auth-subtle a {
            color: #2d47ff;
            font-weight: 600;
            text-decoration: none;
        }
</style>
