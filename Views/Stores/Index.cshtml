@model IEnumerable<StoreMetrics.ViewModels.StoreVm>
@{
    ViewData["Title"] = "Stores List";
    var totalStores = Model.Count();
    var activeStores = Model.Count(s => s.IsActive);
    var inactiveStores = Model.Count(s => !s.IsActive);
}

<!-- ✅ Success Message Box -->
@if (TempData["EditOk"] != null)
{
    <div id="successBox" class="alert-box">
        <div class="alert-content">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                 stroke-width="2.2" stroke="#047857" width="20" height="20">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
            <span>@TempData["EditOk"]</span>
        </div>
        <button type="button" class="close-btn" onclick="closeAlert()">×</button>
    </div>
}

<div class="store-dashboard">
    <!-- 📊 Top Summary Cards -->
    <div class="summary-cards">
        <div class="card stat-card total">
            <div class="icon">🏪</div>
            <div>
                <h3>@totalStores</h3>
                <p>Total Stores</p>
            </div>
        </div>
        <div class="card stat-card active">
            <div class="icon">✅</div>
            <div>
                <h3>@activeStores</h3>
                <p>Active Stores</p>
            </div>
        </div>
        <div class="card stat-card inactive">
            <div class="icon">🚫</div>
            <div>
                <h3>@inactiveStores</h3>
                <p>Inactive Stores</p>
            </div>
        </div>
    </div>

    <!-- 🧭 Filter Tabs and Search -->
    <div class="filter-bar">
        <div class="tabs">
            <button class="tab-btn active" data-filter="all">All</button>
            <button class="tab-btn" data-filter="active">Active</button>
            <button class="tab-btn" data-filter="inactive">Inactive</button>
        </div>
        <div class="search-wrap">
            <input type="text" id="searchInput" placeholder="Search by store name..." />
        </div>
    </div>

    <!-- 📋 Store Table -->
    <div class="card store-table-card">
        <h2 class="title">Store Management</h2>

        <table class="table" id="storeTable">
            <thead>
                <tr>
                    <th>Store Name</th>
                    <th>Store Address</th>
                    <th>Audit Schedule</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr class="store-row @(s.IsActive ? "active-row" : "inactive-row")">
                        <td class="store-name">@s.StoreName</td>
                        <td>
                            @($"{(string.IsNullOrWhiteSpace(s.BuildingNumber) ? "" : s.BuildingNumber + " ")}{s.StreetName}, {s.Brgy}, {s.City}, {s.Province}, {s.PostalCode}")
                        </td>

                        <td>@(s.AuditDate?.ToString("MM/dd/yyyy") ?? "-")</td>

                        <td>
                            <span class="status-badge @(s.IsActive ? "active" : "inactive")">
                                @(s.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-outline">Edit</a>
                            <form asp-action="ToggleStatus" method="post" style="display:inline;">
                                <input type="hidden" name="id" value="@s.Id" />
                                <button type="submit" class="btn @(s.IsActive ? "btn-danger" : "btn-success")">
                                    @(s.IsActive ? "Set as Inactive" : "Set as Active")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        // ✅ Success alert auto fade
        function closeAlert() {
            const box = document.getElementById("successBox");
            if (box) {
                box.style.opacity = "0";
                setTimeout(() => box.remove(), 400);
            }
        }

        window.addEventListener("load", () => {
            const box = document.getElementById("successBox");
            if (box) setTimeout(() => closeAlert(), 4000);
        });

        // 🔍 Search function
        const searchInput = document.getElementById('searchInput');
        const rows = document.querySelectorAll('.store-row');

        searchInput.addEventListener('input', () => {
            const q = searchInput.value.toLowerCase();
            rows.forEach(row => {
                const name = row.querySelector('.store-name').textContent.toLowerCase();
                row.style.display = name.includes(q) ? '' : 'none';
            });
        });

        // 🧭 Filter tabs
        const tabs = document.querySelectorAll('.tab-btn');
        tabs.forEach(tab => {
            tab.addEventListener('click', () => {
                tabs.forEach(t => t.classList.remove('active'));
                tab.classList.add('active');
                const filter = tab.dataset.filter;

                rows.forEach(row => {
                    if (filter === 'all') row.style.display = '';
                    else if (filter === 'active')
                        row.style.display = row.classList.contains('active-row') ? '' : 'none';
                    else
                        row.style.display = row.classList.contains('inactive-row') ? '' : 'none';
                });
            });
        });
    </script>

    <style>
        /* === Modernized Typography & Layout === */
        body {
            background: #f5f7fb;
            font-family: 'Segoe UI', Roboto, sans-serif;
            font-size: 13.5px;
            color: #334155;
        }

        .title {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 16px;
            color: #0f172a;
        }

        .store-dashboard {
            max-width: 1100px;
            margin: 24px auto;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        /* Cards */
        .summary-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 14px;
        }

        .stat-card {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 14px 18px;
            border-radius: 10px;
            color: #fff;
            box-shadow: 0 3px 10px rgba(15, 45, 145, 0.08);
            font-size: 13px;
        }

            .stat-card .icon {
                font-size: 22px;
            }

            .stat-card.total {
                background: linear-gradient(90deg, #0f2b8f, #4f7cff);
            }

            .stat-card.active {
                background: linear-gradient(90deg, #059669, #34d399);
            }

            .stat-card.inactive {
                background: linear-gradient(90deg, #b91c1c, #ef4444);
            }

            .stat-card h3 {
                font-size: 18px;
                margin: 0;
                font-weight: 700;
            }

            .stat-card p {
                font-size: 12.5px;
                opacity: 0.9;
                margin: 0;
            }

        /* Filter & Search */
        .filter-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 8px;
        }

        .tab-btn {
            background: #e2e8f0;
            border: none;
            padding: 6px 12px;
            border-radius: 6px;
            font-weight: 500;
            font-size: 13px;
            color: #1e3a8a;
            cursor: pointer;
            transition: all .2s ease;
        }

            .tab-btn.active {
                background: linear-gradient(90deg, #4f7cff, #0f2b8f);
                color: #fff;
            }

        .search-wrap input {
            padding: 6px 12px;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            min-width: 200px;
            font-size: 13px;
            transition: all .2s ease;
        }

            .search-wrap input:focus {
                border-color: #4f7cff;
                box-shadow: 0 0 0 2px rgba(79, 124, 255, 0.25);
                outline: none;
            }

        /* Table */
        .store-table-card {
            background: #fff;
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 4px 18px rgba(15, 45, 145, 0.05);
        }

        .table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }

            .table th, .table td {
                padding: 10px 12px;
                border-bottom: 1px solid #e5e7eb;
                vertical-align: middle;
            }

            .table th {
                background: #f9fafb;
                font-weight: 600;
                color: #1e293b;
                text-transform: uppercase;
                font-size: 12px;
                letter-spacing: 0.3px;
            }

            .table td {
                color: #475569;
            }

                /* Fix: Align Edit + Set Active buttons horizontally */
                .table td:last-child {
                    display: flex;
                    gap: 6px;
                    align-items: center;
                    white-space: nowrap;
                }

        /* Status */
        .status-badge {
            padding: 3px 8px;
            border-radius: 6px;
            font-weight: 600;
            font-size: 12px;
        }

            .status-badge.active {
                background: #dcfce7;
                color: #166534;
            }

            .status-badge.inactive {
                background: #fee2e2;
                color: #991b1b;
            }

        /* Buttons */
        .btn {
            padding: 5px 10px;
            border-radius: 6px;
            font-weight: 500;
            font-size: 12.5px;
            cursor: pointer;
            transition: all .2s ease;
        }

        .btn-outline {
            border: 1.5px solid #4f7cff;
            color: #0f2b8f;
            background: #fff;
        }

            .btn-outline:hover {
                background: #4f7cff;
                color: #fff;
            }

        .btn-danger {
            background: #ef4444;
            color: #fff;
            border: none;
        }

        .btn-success {
            background: #16a34a;
            color: #fff;
            border: none;
        }

        .btn-danger:hover {
            background: #dc2626;
        }

        .btn-success:hover {
            background: #15803d;
        }

        /* Alert */
        .alert-box {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #ecfdf5;
            color: #065f46;
            border: 1px solid #a7f3d0;
            border-radius: 8px;
            padding: 10px 14px;
            font-weight: 500;
            font-size: 13px;
            max-width: 400px;
            margin: 16px auto;
            transition: opacity 0.3s ease;
        }

        .alert-content {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .close-btn {
            background: transparent;
            border: none;
            color: #065f46;
            font-size: 16px;
            cursor: pointer;
            margin-left: 8px;
        }

            .close-btn:hover {
                color: #047857;
            }
    </style>
}