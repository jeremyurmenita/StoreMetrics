@using System.Text.Json
@model IEnumerable<StoreMetrics.ViewModels.EvaluationSummaryVm>

@{
    ViewData["Title"] = "Report Overviews";

    var latest = (IDictionary<string, StoreMetrics.ViewModels.EvaluationVm>)
          (ViewBag.LatestMap ?? new Dictionary<string, StoreMetrics.ViewModels.EvaluationVm>());

    var storeMap = (IDictionary<string, string>)(ViewBag.StoreMap ?? new Dictionary<string, string>());

    var latestDto = latest.Select(kv => new
    {
        storeId = kv.Key,
        storeName = kv.Value.StoreName,

        // Safely read the full address string from StoreMap
        storeAddress = storeMap.ContainsKey(kv.Key)
                        ? storeMap[kv.Key]
                        : "Address not available",

        ratings = new
        {
            cleanliness = kv.Value.Cleanliness,
            condition = kv.Value.Condition,
            engagement = kv.Value.CustomerEngagement,
            grooming = kv.Value.PersonalGrooming,
            accuracy = kv.Value.Accuracy,
            speed = kv.Value.SpeedOfService,
            quality = kv.Value.ProductQuality
        },

        remarks = kv.Value.Remarks ?? ""
    }).ToList();

    var detailsJson = JsonSerializer.Serialize(latestDto);

    var selectedStore = Context.Request.Query["storeId"].ToString();
    var selectedYear = Context.Request.Query["year"].ToString();
    var selectedQuarter = Context.Request.Query["quarter"].ToString();
    var yearOptions = (List<int>)(ViewBag.YearOptions ?? new List<int>());
    var quarters = new[] { "Quarter", "Q1", "Q2", "Q3", "Q4" };
}

<div class="report-wrapper">

    <div class="report-card">
        <div class="report-card-header">
            <h2>Evaluation Summaries</h2>
        </div>
        <div class="report-card-body">
            <form method="get" asp-action="Overview" class="report-filters">
                <select name="performanceFilter" class="input report-input">

                    <option value=""
                            selected="@(Context.Request.Query["performanceFilter"] == "" ? "selected" : null)">
                        All Stores
                    </option>

                    <option value="Excellent"
                            selected="@(Context.Request.Query["performanceFilter"] == "Excellent" ? "selected" : null)">
                        Excellent
                    </option>

                    <option value="Good"
                            selected="@(Context.Request.Query["performanceFilter"] == "Good" ? "selected" : null)">
                        Good
                    </option>

                    <option value="Average"
                            selected="@(Context.Request.Query["performanceFilter"] == "Average" ? "selected" : null)">
                        Average
                    </option>

                    <option value="Poor"
                            selected="@(Context.Request.Query["performanceFilter"] == "Poor" ? "selected" : null)">
                        Poor
                    </option>

                    <option value="Very Poor"
                            selected="@(Context.Request.Query["performanceFilter"] == "Very Poor" ? "selected" : null)">
                        Very Poor
                    </option>

                </select>

                <select name="year" class="input report-input">
                    <option value="">All Years</option>
                    @foreach (var y in yearOptions)
                    {
                        <option value="@y" selected="@(selectedYear == y.ToString() ? "selected" : null)">@y</option>
                    }
                </select>

                <select name="quarter" class="input report-input">
                    @foreach (var q in quarters)
                    {
                        <option value="@q" selected="@(selectedQuarter == q ? "selected" : null)">@q</option>
                    }
                </select>

                <input name="search" id="searchBox" class="input report-input report-search" placeholder="Search Store"
                       value="@Context.Request.Query["search"]" />

                <button type="submit" class="btn-submit report-btn-filter">Filter</button>
            </form>

            <div class="report-table-wrapper">
                <table class="report-table" id="summaryTable">
                    <thead>
                        <tr>
                            <th>Rank</th>
                            <th>Store Name</th>
                            <th>Total Performance</th>
                            <th>Average Rating</th>
                            <th>Evaluation Date</th>
                            <th>Performance</th>
                            <th style="text-align: right;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model)
                        {
                            <tr data-store="@s.StoreId" data-id="@s.EvaluationId" class="summary-row">
                                <td>
                                    <span class="report-rank-badge @(s.IsTopPerformer ? "top-performer" : "")">
                                        @s.Rank
                                    </span>
                                </td>
                                <td class="report-store-name">@s.StoreName</td>
                                <td>@s.PerformancePercent.ToString("0.00")%</td>
                                <td>@s.AverageRating.ToString("0.00")</td>
                                <td>@s.EvaluationDate.ToString("yyyy-MM-dd")</td>
                                <td>
                                    <span class="report-performance-badge @(s.PerformanceDescription switch {
                                            "Excellent" => "report-badge-excellent",
                                            "Good" => "report-badge-good",
                                            "Average" => "report-badge-average",
                                            _ => "report-badge-poor"
                                        })">
                                        @s.PerformanceDescription
                                    </span>
                                </td>
                                <td class="report-actions">
                                    <button class="btn btn-outline editBtn" data-id="@s.EvaluationId"
                                            data-store="@s.StoreId" data-name="@s.StoreName">
                                        Edit
                                    </button>
                                    <button class="btn btn-danger deleteBtn" data-id="@s.EvaluationId">
                                        Delete
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (ViewBag.TotalPages > 1)
                {
                    <div class="pagination-wrapper">
                        <div class="pagination">

                            <!-- Previous -->
                            <a class="page-btn @(ViewBag.CurrentPage == 1 ? "disabled" : "")"
                               href="@Url.Action("Overview", new {
                                    page = ViewBag.CurrentPage - 1,
                                    storeId = selectedStore,
                                    year = selectedYear,
                                    quarter = selectedQuarter,
                                    search = ViewBag.Search
                               })">Previous</a>

                            <!-- Page numbers -->
                            @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
                            {
                                <a class="page-btn @(i == ViewBag.CurrentPage ? "active" : "")"
                                   href="@Url.Action("Overview", new {
                                        page = i,
                                        storeId = selectedStore,
                                        year = selectedYear,
                                        quarter = selectedQuarter,
                                        search = ViewBag.Search
                                   })">@i</a>
                            }

                            <!-- Next -->
                            <a class="page-btn @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")"
                               href="@Url.Action("Overview", new {
                                    page = ViewBag.CurrentPage + 1,
                                    storeId = selectedStore,
                                    year = selectedYear,
                                    quarter = selectedQuarter,
                                    search = ViewBag.Search
                               })">Next</a>

                        </div>
                    </div>
                }

            </div>
        </div>
    </div>

    <div class="report-card">
        <div class="report-card-header">
            <h2 id="detailTitle">Detailed Scores</h2>
        </div>

        <div id="detailEmpty" class="report-empty-state">
            Select a store from the table above to view detailed scores and remarks.
        </div>

        <div id="detailPanel" style="display:none">
            <div class="report-detail-list" id="detailBody"></div>

            <div id="remarksBlock" class="report-remarks-block" style="display:none;">
                <strong>Remarks:</strong>
                <p id="remarksText"></p>
            </div>
        </div>
    </div>
</div>

<div id="editModal" class="modal-overlay" style="display:none;">
    <div class="modal-content">
        <h3 id="modalStoreName"></h3>
        <p>Edit Evaluation Ratings</p>

        <form id="editForm">
            <input type="hidden" id="editId" />
            <input type="hidden" id="editStoreId" />

            <div id="editFields"></div>

            <label style="margin-top:14px; font-weight: 600;">Remarks</label>
            <textarea id="editRemarks" class="input" rows="3"></textarea>

            <div style="margin-top:18px;display:flex;justify-content:end;gap:10px;">
                <button type="button" id="cancelEdit" class="btn-cancel">Cancel</button>
                <button type="submit" class="btn-submit">Save Changes</button>
            </div>
        </form>
    </div>
</div>

<div id="deleteModal" class="modal-overlay" style="display:none;">
    <div class="modal-content">
        <div class="delete-modal-icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
            </svg>
        </div>
        <h3 class="delete-modal-title">Confirm Deletion</h3>
        <p class="delete-modal-message">Are you sure you want to delete this evaluation? This action cannot be undone.</p>
        <input type="hidden" id="deleteEvaluationId" />
        <div class="delete-modal-actions">
            <button type="button" id="cancelDeleteBtn" class="btn-cancel">Cancel</button>
            <button type="button" id="confirmDeleteBtn" class="btn-danger-submit">Yes, Delete</button>
        </div>
    </div>
</div>

<div id="toast" class="toast">✓ Updated Successfully</div>

@section Scripts {
    <script>
        const DETAILS = @Html.Raw(detailsJson);
        const rows = Array.from(document.querySelectorAll('#summaryTable tbody tr'));
        const panel = document.getElementById('detailPanel');
        const empty = document.getElementById('detailEmpty');
        const body = document.getElementById('detailBody');
        const dTitle = document.getElementById('detailTitle');
        const remarksBlock = document.getElementById('remarksBlock');
        const remarksText = document.getElementById('remarksText');
        const modal = document.getElementById('editModal');
        const toast = document.getElementById('toast');
        const modalStoreName = document.getElementById('modalStoreName');
        const deleteModal = document.getElementById('deleteModal');
        const confirmDeleteBtn = document.getElementById('confirmDeleteBtn');
        const cancelDeleteBtn = document.getElementById('cancelDeleteBtn');
        const deleteEvaluationIdInput = document.getElementById('deleteEvaluationId');

        // NEW: criteria text (basis) for each category
        const criteriaText = {
            "Cleanliness": "The sales floor and service areas are free of wet and dry trash, and trash bins are clean and covered.",
            "Condition": "Store fixtures, furniture, and equipment are clean, undamaged, and functioning properly.",
            "Customer Engagement": "Staff greet customers promptly, show courtesy, and offer assistance when needed.",
            "Personal Grooming": "Employees are neat, clean, and follow the required dress code or uniform standards.",
            "Accuracy": "All transactions, orders, and information provided to customers are correct and error-free.",
            "Speed of Service": "Customers are served promptly, with minimal delays in transaction processing or service.",
            "Product Quality": "Products meet the required standards—fresh, complete, properly packaged, and presentable."
        };

        // NEW: convert 1–5 to Strongly Agree ... Strongly Disagree
        function ratingText(val) {
            switch (Number(val)) {
                case 5: return "Strongly Agree";
                case 4: return "Agree";
                case 3: return "Neutral";
                case 2: return "Disagree";
                case 1: return "Strongly Disagree";
                default: return "No Rating";
            }
        }

        // Icons
        const detailIcons = {
            'Cleanliness': `<path stroke-linecap='round' stroke-linejoin='round' d='M9.53 16.122a3 3 0 00-5.78 1.128 2.25 2.25 0 01-2.4 2.245 4.5 4.5 0 008.4-2.245c0-.399-.078-.78-.22-1.128zm0 0a15.998 15.998 0 003.388-1.62m-5.043-.025a15.994 15.994 0 011.622-3.388m5.043.025a15.994 15.994 0 001.622-3.388m3.879 1.62a15.99 15.99 0 00-1.62-3.389m-5.043-.024a15.994 15.994 0 01-1.622-3.389m5.043.024a15.99 15.99 0 01-1.62 3.389M7.538 12.762a15.99 15.99 0 00-1.62 3.388m5.043-.024a15.994 15.994 0 011.622 3.388m-5.043-.024a15.99 15.99 0 011.62 3.388m1.62-3.388a15.99 15.99 0 001.62 3.388m-1.62-3.388a15.994 15.994 0 01-1.622 3.389' />`,
            'Condition': `<path stroke-linecap='round' stroke-linejoin='round' d='M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M8.25 6h7.5m-7.5 3h7.5m-7.5 3h7.5m-7.5 3h7.5M12 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21' />`,
            'Customer Engagement': `<path stroke-linecap='round' stroke-linejoin='round' d='M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-3.11 8.25-7 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.454-.067-.927-.445-1.214a6.523 6.523 0 01-.393-.362A8.93 8.93 0 012.25 12c0-4.556 3.11-8.25 7-8.25s7 3.694 7 8.25z' />`,
            'Personal Grooming': `<path stroke-linecap='round' stroke-linejoin='round' d='M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A1.875 1.875 0 0118 22.5H6a1.875 1.875 0 01-1.501-2.382z' />`,
            'Accuracy': `<path stroke-linecap='round' stroke-linejoin='round' d='M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z' />`,
            'Speed of Service': `<path stroke-linecap='round' stroke-linejoin='round' d='M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z' />`,
            'Product Quality': `<path stroke-linecap='round' stroke-linejoin='round' d='M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.31h5.513c.491 0 .702.657.337.986l-4.261 3.14a.563.563 0 00-.214.617l1.618 4.894a.562.562 0 01-.815.626l-4.202-3.098a.563.563 0 00-.638 0L8.602 19.88a.562.562 0 01-.815-.626l1.618-4.894a.563.563 0 00-.214-.617L5.05 9.907c-.365-.269-.154-.986.337-.986h5.513a.563.563 0 00.475-.31L11.48 3.5z' />`
        };

        function badge(n) { return `<span class="report-detail-value-badge">${n}</span>`; }
        function hideDetails(){panel.style.display='none';empty.style.display='block';}

        function renderDetails(storeId){
            const d = DETAILS.find(x => x.storeId === storeId);
            if(!d){ hideDetails(); return; }

            dTitle.innerHTML = `
                Detailed Scores — ${d.storeName}
                <div style="font-size:14px;color:#6b7280;margin-top:4px;">
                    📍 ${d.storeAddress}
                </div>
            `;

            const rows = [
                ['Cleanliness', d.ratings.cleanliness],
                ['Condition', d.ratings.condition],
                ['Customer Engagement', d.ratings.engagement],
                ['Personal Grooming', d.ratings.grooming],
                ['Accuracy', d.ratings.accuracy],
                ['Speed of Service', d.ratings.speed],
                ['Product Quality', d.ratings.quality],
            ];

            body.innerHTML = rows.map(([label,val]) => {
                const iconSvg = detailIcons[label] || detailIcons['Accuracy'];
                const criteria = criteriaText[label] || "";
                const labelText = ratingText(val);

                return `
                <div class="report-detail-row">
                    <div class="report-detail-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            ${iconSvg}
                        </svg>
                    </div>

                    <div class="report-detail-main">
                        <div class="report-detail-top">
                            <span class="report-detail-label">${label}</span>

                            <div class="report-detail-right">
                                ${badge(val||'—')}
                                <span class="report-detail-rating-text">${labelText}</span>
                            </div>
                        </div>

                        <div class="report-detail-desc">${criteria}</div>
                    </div>
                </div>
                `;
            }).join('');

            if (d.remarks && d.remarks.trim() !== "") {
                remarksText.textContent = d.remarks;
                remarksBlock.style.display = 'block';
            } else {
                remarksText.textContent = "";
                remarksBlock.style.display = 'none';
            }

            empty.style.display = 'none';
            panel.style.display = 'block';
            panel.scrollIntoView({behavior:'smooth',block:'nearest'});
        }

        document.querySelectorAll('.editBtn').forEach(btn=>{
            btn.addEventListener('click',e=>{
                e.stopPropagation();
                const id=btn.dataset.id,storeId=btn.dataset.store,name=btn.dataset.name;
                const d=DETAILS.find(x=>x.storeId===storeId); if(!d)return;
                document.getElementById('editId').value=id;
                document.getElementById('editStoreId').value=storeId;
                modalStoreName.textContent = `Editing Evaluation for ${name}`;
                const fields=[
                    ['Cleanliness',d.ratings.cleanliness],
                    ['Condition',d.ratings.condition],
                    ['Customer Engagement',d.ratings.engagement],
                    ['Personal Grooming',d.ratings.grooming],
                    ['Accuracy',d.ratings.accuracy],
                    ['Speed of Service',d.ratings.speed],
                    ['Product Quality',d.ratings.quality],
                ];
                document.getElementById('editFields').innerHTML=fields.map(([label,val])=>`
                    <div>
                        <label>${label}</label>
                        <select class="input" name="${label.replace(/ /g,'')}">
                            ${[1,2,3,4,5].map(n=>`<option value="${n}"${val==n?' selected':''}>${n}</option>`).join('')}
                        </select>
                    </div>`).join('');
                document.getElementById('editRemarks').value=d.remarks||"";
                modal.style.display='flex';
            });
        });
        document.getElementById('cancelEdit').onclick=()=>modal.style.display='none';

        document.getElementById('editForm').onsubmit=async e=>{
            e.preventDefault();
            const data={Id:editId.value,StoreId:editStoreId.value,StoreName:modalStoreName.textContent.replace('Editing Evaluation for ',''),
                Remarks:editRemarks.value};
            document.querySelectorAll('#editFields select').forEach(sel=>{data[sel.name]=Number(sel.value);});
            const res=await fetch('/Reports/EditEvaluation',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});
            if(res.ok){
                modal.style.display='none';
                toast.textContent="✓ Updated Successfully";
                toast.classList.add('show');
                setTimeout(()=>toast.classList.remove('show'),2000);
                setTimeout(()=>location.reload(),800);
            }
        };

        document.querySelectorAll('.deleteBtn').forEach(btn=>{
            btn.addEventListener('click',async e=>{
                e.stopPropagation();
                const id = btn.dataset.id;
                deleteEvaluationIdInput.value = id;
                deleteModal.style.display = 'flex';
            });
        });

        cancelDeleteBtn.addEventListener('click', () => {
            deleteModal.style.display = 'none';
        });

        confirmDeleteBtn.addEventListener('click', async () => {
            const id = deleteEvaluationIdInput.value;
            if (!id) return;

            await fetch('/Reports/DeleteEvaluation',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(id)});

            deleteModal.style.display = 'none';
            toast.textContent="✓ Deleted Successfully";
            toast.classList.add('show');
            setTimeout(()=>toast.classList.remove('show'),2000);
            setTimeout(()=>location.reload(),800);
        });

        rows.forEach(r=>r.addEventListener('click',()=>renderDetails(r.getAttribute('data-store'))));
    </script>
}

<style>
    .pagination-wrapper {
        margin-top: 20px;
        display: flex;
        justify-content: center;
    }

    .pagination {
        display: flex;
        gap: 6px;
    }

    .page-btn {
        padding: 6px 12px;
        border-radius: 8px;
        background: #e2e8f0;
        color: #1e3a8a;
        font-weight: 600;
        text-decoration: none;
        transition: 0.2s;
    }

        .page-btn:hover {
            background: #cbd5e1;
        }

        .page-btn.active {
            background: linear-gradient(90deg,#4f7cff,#0f2b8f);
            color: white;
        }

        .page-btn.disabled {
            opacity: 0.4;
            pointer-events: none;
        }

    .report-wrapper {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 24px;
    }

    .report-card {
        background: var(--color-card, #ffffff);
        border-radius: 16px;
        box-shadow: var(--shadow-md, 0 10px 30px rgba(15, 23, 42, 0.12));
        border: 1px solid var(--color-border, #e5e7eb);
        overflow: hidden;
    }

    .report-card-header {
        padding: 20px 24px;
        border-bottom: 1px solid var(--color-border, #e5e7eb);
    }

        .report-card-header h2 {
            font-size: 20px;
            font-weight: 700;
            color: var(--color-text, #111827);
            margin: 0;
        }

    .report-card-body {
        padding: 24px;
    }

    .report-filters {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        align-items: center;
        margin-bottom: 20px;
    }

    .report-input {
        background-color: var(--color-input-bg, #f8fafc) !important;
        font-family: var(--font-main, 'Inter', 'Segoe UI');
        flex-grow: 1;
        flex-basis: 150px;
    }

    .report-filters select[name="storeId"] {
        flex-basis: 200px;
    }

    .report-filters .report-search {
        flex-basis: 200px;
    }

    .report-btn-filter {
        min-width: 100px;
        padding: 10px 20px !important;
        font-size: 14px !important;
        font-weight: 600 !important;
        margin-top: 0 !important;
        border-radius: var(--radius-md, 8px) !important;
        background: var(--color-primary-gradient, linear-gradient(90deg, #4f7cff, #0f2b8f)) !important;
        display: flex;
        align-items: center;
        justify-content: center;
        width: auto;
        color: #fff;
        border: none;
        cursor: pointer;
        box-shadow: 0 6px 16px rgba(15, 23, 42, 0.15);
        transition: all 0.3s ease;
        flex-grow: 0;
        flex-shrink: 0;
    }

        .report-btn-filter:hover {
            background: var(--color-primary-gradient-hover, linear-gradient(90deg, #0f2b8f, #4f7cff)) !important;
            transform: translateY(-1px);
        }

    .report-table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .report-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
    }

        .report-table th, .report-table td {
            padding: 14px 16px;
            border-bottom: 1px solid var(--color-border, #e5e7eb);
            text-align: left;
            white-space: nowrap;
            vertical-align: middle;
        }

        .report-table th {
            background: #f9fafb;
            font-weight: 600;
            color: var(--color-text-light, #6b7280);
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .report-table tbody tr {
            cursor: pointer;
            transition: background-color 0.2s ease;
        }

            .report-table tbody tr:hover {
                background-color: #f9fafb;
            }

            .report-table tbody tr:last-child td {
                border-bottom: none;
            }

    .report-rank-badge {
        display: inline-block;
        width: 28px;
        height: 28px;
        line-height: 28px;
